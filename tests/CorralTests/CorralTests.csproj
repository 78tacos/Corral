<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test program for LinkStore and the settings file: compiles the real source files and runs assertions.
       Run it from the repo root with: dotnet run, pointing at this project folder. Exit code 0 means all passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CorralTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\LinkStore.cs" Link="LinkStore.cs" />
    <Compile Include="..\..\Config.cs" Link="Config.cs" />
  </ItemGroup>

</Project>
