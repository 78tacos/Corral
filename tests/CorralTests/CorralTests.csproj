<Project Sdk="Microsoft.NET.Sdk">

  <!-- LinkStore and settings-file checks, compiled against the real source files.
       `dotnet test` runs them and fails the run when a check fails. `dotnet run` prints
       PASS, FAIL, or SKIP for each check and exits 1 when any check failed.
       Checks that create a .lnk are skipped when WScript.Shell is unavailable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CorralTests</RootNamespace>
    <!-- The test SDK would otherwise generate a second, empty Main. Ours runs the checks. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\LinkStore.cs" Link="LinkStore.cs" />
    <Compile Include="..\..\Config.cs" Link="Config.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
