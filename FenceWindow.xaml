<Window x:Class="Corral.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Corral"
        Title="Fence"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Width="320" Height="240" MinWidth="110" MinHeight="28"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Drop="Fence_Drop" DragOver="Fence_DragOver"
        MouseEnter="Fence_MouseEnter" MouseLeave="Fence_MouseLeave">

    <Border x:Name="Frame" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="8" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: drag to move, double-click to roll up, right-click for the fence menu -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="#30000000" CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown"
                    MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"
                    MouseRightButtonUp="Fence_RightClick">
                <TextBlock x:Name="TitleText"
                           Foreground="#F2FFFFFF" FontSize="12.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="10,0" IsHitTestVisible="False"/>
            </Border>

            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Foreground="White" Margin="4,4,2,4" AllowDrop="True"
                     SelectionMode="Extended" ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=local:FenceWindow}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="List_PreviewMouseMove"
                     PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                     MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=local:FenceWindow}}"/>
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FenceItem}">
                        <StackPanel Background="Transparent" ToolTip="{Binding Path}">
                            <Image Source="{Binding Icon}"
                                   Width="{Binding IconPx, RelativeSource={RelativeSource AncestorType=local:FenceWindow}}"
                                   Height="{Binding IconPx, RelativeSource={RelativeSource AncestorType=local:FenceWindow}}"
                                   Margin="0,2,0,3" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxHeight="32">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="Drop files, folders or shortcuts here"
                       Foreground="#99FFFFFF" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- Resize grips -->
            <Grid Grid.RowSpan="2">
                <Rectangle Tag="L" Width="5" HorizontalAlignment="Left" Margin="0,10,0,10" Fill="Transparent" Cursor="SizeWE"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="R" Width="5" HorizontalAlignment="Right" Margin="0,10,0,10" Fill="Transparent" Cursor="SizeWE"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="B" Height="5" VerticalAlignment="Bottom" Margin="10,0,10,0" Fill="Transparent" Cursor="SizeNS"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="T" Height="3" VerticalAlignment="Top" Margin="10,0,10,0" Fill="Transparent" Cursor="SizeNS"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="BL" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="BR" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="TL" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
                <Rectangle Tag="TR" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW"
                           MouseLeftButtonDown="Grip_MouseLeftButtonDown" MouseMove="Drag_MouseMove" MouseLeftButtonUp="Drag_MouseLeftButtonUp"/>
            </Grid>
        </Grid>
    </Border>
</Window>
